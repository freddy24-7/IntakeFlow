# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Local PostgreSQL (docker compose reads these)
POSTGRES_USER=intakeflow
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_DB=intakeflow

# Application database URL (async driver). Tests use the same server with "_test" appended to the name.
DATABASE_URL=postgresql+asyncpg://intakeflow:<same-local-password>@localhost:5432/intakeflow

# Score needed for auto-approval, on top of passing validation. 0 = validation alone decides.
AUTO_APPROVE_THRESHOLD=0.0

# Largest accepted upload in bytes
MAX_UPLOAD_BYTES=20971520

# Folder for uploaded files (Blob Storage replaces it in stage 6)
STORAGE_DIR=data/uploads

# Azure endpoints. Leave empty to run without Azure: uploads are then stored but not processed.
# Sign-in is keyless (az login), so there are no keys to set.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CLASSIFY_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EXTRACT_DEPLOYMENT=gpt-4.1
EXTRACTION_VARIANT=combined

# Scoring and routing (stage 3)
SCORE_AGGREGATE=mean
SCORE_DEFAULT_CONFIDENCE=0.80
CLASSIFICATION_THRESHOLD=0.80
PO_AMOUNT_TOLERANCE=0.01
MAX_ATTEMPTS=3
