# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Local PostgreSQL (docker compose reads these)
POSTGRES_USER=intakeflow
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_DB=intakeflow

# Application database URL (async driver). Tests use the same server with "_test" appended to the name.
DATABASE_URL=postgresql+asyncpg://intakeflow:<same-local-password>@localhost:5432/intakeflow

# Combined score needed for auto-approval (rule: deterministic validation must also pass)
AUTO_APPROVE_THRESHOLD=0.90

# Largest accepted upload in bytes
MAX_UPLOAD_BYTES=20971520
