// The application itself: web and worker on Container Apps, with Postgres, Blob and
// Queue Storage, Key Vault, a container registry and monitoring.
//
// Unlike ai.bicep, parts of this cost money while idle (Postgres and the registry).
// Everything here carries the tag part=app, so deploy/down-app.sh can remove it
// and leave the AI resources in place.

param location string
param developerObjectId string

@description('Image tag to run. Empty creates everything except the two container apps.')
param imageTag string = ''

@secure()
@description('Password for the database administrator. Generated by deploy/up-app.sh on every deploy.')
param postgresPassword string

@description('Client id of the Entra app registration used for sign-in to the web application.')
param authClientId string = ''

param documentIntelligenceName string
param openAiName string
param searchName string
param documentIntelligenceEndpoint string
param openAiEndpoint string
param searchEndpoint string

// The region is part of the names, so a move to another region does not collide
// with names that the old region still holds for a while after deletion.
var suffix = uniqueString(resourceGroup().id, location)
var tags = { part: 'app', project: 'intakeflow' }
var databaseName = 'intakeflow'
var databaseUser = 'intakeflow'
var queueName = 'documents'
var containerName = 'documents'
var imageName = 'intakeflow'

// Built-in role ids
var roles = {
  acrPull: '7f951dda-4ed3-4680-a7ca-43fe172d538d'
  blobDataContributor: 'ba92f5b4-2d11-453d-a403-e96b0029c9fe'
  queueDataContributor: '974c5e8b-45b9-4653-ba55-5f855dd0fb88'
  keyVaultSecretsUser: '4633458b-17de-408a-b874-0445c86b69e6'
  cognitiveServicesUser: 'a97b65f3-24c7-4388-baec-2e87135dc908'
  cognitiveServicesOpenAiUser: '5e0bd9bd-7b93-4f28-af87-19fc36ad61bd'
  searchIndexDataContributor: '8ebe5a00-799e-43f5-93ac-243d3dce84a7'
  searchServiceContributor: '7ca78c08-252a-4471-8644-bb5ff32d4ba0'
}

// One identity for both container apps. It is how the application signs in to
// every other resource, so no key or connection string is stored anywhere.
resource identity 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'id-intakeflow-${suffix}'
  location: location
  tags: tags
}

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'log-intakeflow-${suffix}'
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = {
  name: 'appi-intakeflow-${suffix}'
  location: location
  tags: tags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logs.id
  }
}

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: 'stintake${suffix}'
  location: location
  tags: tags
  kind: 'StorageV2'
  sku: { name: 'Standard_LRS' }
  properties: {
    // Identity only: account keys are switched off.
    allowSharedKeyAccess: false
    allowBlobPublicAccess: false
    minimumTlsVersion: 'TLS1_2'
    supportsHttpsTrafficOnly: true
  }
}

resource blobs 'Microsoft.Storage/storageAccounts/blobServices@2023-05-01' = {
  parent: storage
  name: 'default'
}

resource documents 'Microsoft.Storage/storageAccounts/blobServices/containers@2023-05-01' = {
  parent: blobs
  name: containerName
}

resource queues 'Microsoft.Storage/storageAccounts/queueServices@2023-05-01' = {
  parent: storage
  name: 'default'
}

resource workQueue 'Microsoft.Storage/storageAccounts/queueServices/queues@2023-05-01' = {
  parent: queues
  name: queueName
}

resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: 'crintakeflow${suffix}'
  location: location
  tags: tags
  sku: { name: 'Basic' }
  properties: {
    adminUserEnabled: false
  }
}

resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: 'psql-intakeflow-${suffix}'
  location: location
  tags: tags
  sku: {
    name: 'Standard_B1ms'
    tier: 'Burstable'
  }
  properties: {
    version: '17'
    administratorLogin: databaseUser
    administratorLoginPassword: postgresPassword
    storage: { storageSizeGB: 32 }
    backup: { backupRetentionDays: 7, geoRedundantBackup: 'Disabled' }
    highAvailability: { mode: 'Disabled' }
    network: { publicNetworkAccess: 'Enabled' }
  }
}

resource database 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: databaseName
}

// Lets resources inside Azure reach the server, which the container apps need.
// It is not limited to this subscription. The password and TLS are what protect
// the database. A private network would be the stricter choice.
resource allowAzure 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: postgres
  name: 'AllowAllAzureServicesAndResourcesWithinAzureIps'
  properties: {
    startIpAddress: '0.0.0.0'
    endIpAddress: '0.0.0.0'
  }
}

resource vault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'kv-intake-${suffix}'
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enableSoftDelete: true
    softDeleteRetentionInDays: 7
  }
}

// The one secret in the system. The container apps read it through their identity.
resource databaseUrl 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'database-url'
  properties: {
    value: 'postgresql+asyncpg://${databaseUser}:${postgresPassword}@${postgres.properties.fullyQualifiedDomainName}:5432/${databaseName}?ssl=require'
  }
}

// Role assignments for the application's identity

resource existingDocumentIntelligence 'Microsoft.CognitiveServices/accounts@2024-10-01' existing = {
  name: documentIntelligenceName
}

resource existingOpenAi 'Microsoft.CognitiveServices/accounts@2024-10-01' existing = {
  name: openAiName
}

resource existingSearch 'Microsoft.Search/searchServices@2023-11-01' existing = {
  name: searchName
}

resource pullRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: registry
  name: guid(registry.id, identity.id, roles.acrPull)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.acrPull)
  }
}

resource blobRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: storage
  name: guid(storage.id, identity.id, roles.blobDataContributor)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.blobDataContributor)
  }
}

resource queueRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: storage
  name: guid(storage.id, identity.id, roles.queueDataContributor)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.queueDataContributor)
  }
}

resource secretRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: vault
  name: guid(vault.id, identity.id, roles.keyVaultSecretsUser)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.keyVaultSecretsUser)
  }
}

resource readingRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: existingDocumentIntelligence
  name: guid(existingDocumentIntelligence.id, identity.id, roles.cognitiveServicesUser)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.cognitiveServicesUser)
  }
}

resource modelRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: existingOpenAi
  name: guid(existingOpenAi.id, identity.id, roles.cognitiveServicesOpenAiUser)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.cognitiveServicesOpenAiUser)
  }
}

resource searchDataRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: existingSearch
  name: guid(existingSearch.id, identity.id, roles.searchIndexDataContributor)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.searchIndexDataContributor)
  }
}

resource searchServiceRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: existingSearch
  name: guid(existingSearch.id, identity.id, roles.searchServiceContributor)
  properties: {
    principalId: identity.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.searchServiceContributor)
  }
}

// So the person deploying can look at uploaded files while debugging.
resource developerBlobRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  scope: storage
  name: guid(storage.id, developerObjectId, roles.blobDataContributor)
  properties: {
    principalId: developerObjectId
    principalType: 'User'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.blobDataContributor)
  }
}

// Container Apps

resource environment 'Microsoft.App/managedEnvironments@2025-01-01' = {
  name: 'cae-intakeflow-${suffix}'
  location: location
  tags: tags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
  }
}

var image = '${registry.properties.loginServer}/${imageName}:${imageTag}'
var settings = [
  { name: 'DATABASE_URL', secretRef: 'database-url' }
  // Tells the Azure SDKs which managed identity to use.
  { name: 'AZURE_CLIENT_ID', value: identity.properties.clientId }
  { name: 'AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT', value: documentIntelligenceEndpoint }
  { name: 'AZURE_OPENAI_ENDPOINT', value: openAiEndpoint }
  { name: 'AZURE_SEARCH_ENDPOINT', value: searchEndpoint }
  { name: 'STORAGE_BACKEND', value: 'blob' }
  { name: 'AZURE_STORAGE_BLOB_URL', value: storage.properties.primaryEndpoints.blob }
  { name: 'BLOB_CONTAINER', value: containerName }
  { name: 'DISPATCH_BACKEND', value: 'queue' }
  { name: 'AZURE_STORAGE_QUEUE_URL', value: storage.properties.primaryEndpoints.queue }
  { name: 'QUEUE_NAME', value: queueName }
  { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: insights.properties.ConnectionString }
  // The demo has no accounting system, so the synthetic purchase orders come with the image.
  { name: 'SEED_PURCHASE_ORDERS_FILE', value: 'data/synthetic/purchase_orders.json' }
]
var configuration = {
  registries: [
    { server: registry.properties.loginServer, identity: identity.id }
  ]
  secrets: [
    { name: 'database-url', keyVaultUrl: databaseUrl.properties.secretUri, identity: identity.id }
  ]
}

resource web 'Microsoft.App/containerApps@2025-01-01' = if (!empty(imageTag)) {
  name: 'ca-intakeflow-web'
  location: location
  tags: tags
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${identity.id}': {} }
  }
  dependsOn: [pullRole, secretRole, allowAzure, database]
  properties: {
    environmentId: environment.id
    configuration: union(configuration, {
      ingress: {
        external: true
        targetPort: 8000
        allowInsecure: false
      }
    })
    template: {
      containers: [
        {
          name: 'web'
          image: image
          env: settings
          resources: { cpu: json('0.5'), memory: '1Gi' }
          probes: [
            {
              type: 'Readiness'
              httpGet: { path: '/health', port: 8000 }
              initialDelaySeconds: 5
              periodSeconds: 10
            }
          ]
        }
      ]
      // Scale to zero: the first request after a quiet period waits for a start.
      scale: { minReplicas: 0, maxReplicas: 1 }
    }
  }
}

// Sign-in with Microsoft, limited to one account. The application's own role
// picker is a demo and gives no protection, and every upload costs money.
resource webAuth 'Microsoft.App/containerApps/authConfigs@2025-01-01' = if (!empty(imageTag) && !empty(authClientId)) {
  parent: web
  name: 'current'
  properties: {
    platform: { enabled: true }
    globalValidation: {
      unauthenticatedClientAction: 'RedirectToLoginPage'
      redirectToProvider: 'azureactivedirectory'
      excludedPaths: ['/health']
    }
    identityProviders: {
      azureActiveDirectory: {
        enabled: true
        registration: {
          clientId: authClientId
          openIdIssuer: '${az.environment().authentication.loginEndpoint}${subscription().tenantId}/v2.0'
        }
        validation: {
          allowedAudiences: [authClientId, 'api://${authClientId}']
          defaultAuthorizationPolicy: {
            allowedPrincipals: { identities: [developerObjectId] }
          }
        }
      }
    }
  }
}

resource worker 'Microsoft.App/containerApps@2025-01-01' = if (!empty(imageTag)) {
  name: 'ca-intakeflow-worker'
  location: location
  tags: tags
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${identity.id}': {} }
  }
  dependsOn: [pullRole, secretRole, queueRole, blobRole, allowAzure, database, web]
  properties: {
    environmentId: environment.id
    configuration: configuration
    template: {
      containers: [
        {
          name: 'worker'
          image: image
          command: ['python', '-m', 'app.worker']
          env: settings
          resources: { cpu: json('0.5'), memory: '1Gi' }
        }
      ]
      // Runs only while there are documents on the queue.
      scale: {
        minReplicas: 0
        maxReplicas: 1
        rules: [
          {
            name: 'documents-waiting'
            azureQueue: {
              accountName: storage.name
              queueName: queueName
              queueLength: 1
              identity: identity.id
            }
          }
        ]
      }
    }
  }
}

output registryName string = registry.name
output registryServer string = registry.properties.loginServer
output environmentDomain string = environment.properties.defaultDomain
output webUrl string = 'https://ca-intakeflow-web.${environment.properties.defaultDomain}'
output vaultName string = vault.name
